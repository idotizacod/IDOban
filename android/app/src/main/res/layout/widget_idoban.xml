<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#f8f9fa"
    android:padding="12dp"
    android:elevation="4dp">

    <!-- Header Ultra-Studio -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="4dp"
            android:layout_height="14dp"
            android:background="#d32f2f" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="IDOban // RECIENTES"
            android:textColor="#1a1a1a"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#d32f2f"
            android:text="04"
            android:textColor="#ffffff"
            android:textSize="8sp"
            android:fontFamily="monospace"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Toca un proyecto para abrirlo"
        android:textColor="#1a1a1a"
        android:alpha="0.5"
        android:textSize="9sp"
        android:fontFamily="monospace" />

    <!-- Lista 4 items (cada uno clickeable) -->
    <LinearLayout
        android:id="@+id/widget_item_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#f8f9fa"
        android:layout_marginTop="8dp"
        android:padding="10dp"
        android:elevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_title_0"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="TESIS 2026"
                android:textColor="#1a1a1a"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/widget_count_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#0a0a0a"
                android:text="3 T"
                android:textColor="#e2e8f0"
                android:textSize="8sp"
                android:fontFamily="monospace"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp" />
        </LinearLayout>

        <!-- Barra segmentada 3 colores -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:background="#0a0a0a">

            <TextView
                android:id="@+id/widget_seg_todo_0"
                android:layout_width="0dp"
                android:layout_weight="33"
                android:layout_height="match_parent"
                android:background="#90a1b9" />
            <TextView
                android:id="@+id/widget_seg_doing_0"
                android:layout_width="0dp"
                android:layout_weight="33"
                android:layout_height="match_parent"
                android:background="#d32f2f" />
            <TextView
                android:id="@+id/widget_seg_done_0"
                android:layout_width="0dp"
                android:layout_weight="34"
                android:layout_height="match_parent"
                android:background="#00c950" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_pct_todo_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="33%"
                android:textColor="#1a1a1a"
                android:textSize="8sp"
                android:fontFamily="monospace"
                android:background="#f8f9fa"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp" />
            <TextView
                android:id="@+id/widget_pct_doing_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="33%"
                android:textColor="#ffffff"
                android:textSize="8sp"
                android:fontFamily="monospace"
                android:background="#d32f2f"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp" />
            <TextView
                android:id="@+id/widget_pct_done_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="34%"
                android:textColor="#ffffff"
                android:textSize="8sp"
                android:fontFamily="monospace"
                android:background="#00c950"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Item 1 (oculto si no hay datos, visible por defecto demo) -->
    <LinearLayout
        android:id="@+id/widget_item_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#f8f9fa"
        android:layout_marginTop="6dp"
        android:padding="10dp"
        android:visibility="gone">
        <TextView android:id="@+id/widget_title_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:fontFamily="monospace" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_item_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
    <LinearLayout android:id="@+id/widget_item_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Abre IDOban para ver tus proyectos aquí"
        android:textColor="#1a1a1a"
        android:alpha="0.4"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:padding="10dp"
        android:visibility="gone"
        android:background="#f8f9fa" />
</LinearLayout>
