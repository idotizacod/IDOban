<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Widget 1 · Proyectos -->
        <receiver
            android:name=".IdobanWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/idoban_widget_info" />
        </receiver>

        <!-- Widget 2 · IDOToDo (Bucket list) -->
        <receiver
            android:name=".TodoListWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.idocod.idoban.TODO_TAB" />
                <action android:name="com.idocod.idoban.TODO_ADD" />
                <action android:name="com.idocod.idoban.TODO_ITEM" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/idoban_todo_widget_info" />
        </receiver>

        <!-- Servicio de lista con scroll del Widget 2 (RemoteViewsService) -->
        <service
            android:name=".TodoListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Entrada de tareas dentro de la app (Widget 2) -->
        <activity
            android:name=".TodoInputActivity"
            android:exported="false"
            android:label="@string/todo_input_title"
            android:theme="@style/AppTheme.TodoInput" />

        <!-- Confirmación de borrado dentro de la app (Widget 2) -->
        <activity
            android:name=".TodoConfirmActivity"
            android:exported="false"
            android:theme="@style/AppTheme.TodoInput" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
